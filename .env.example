# Path to your Qwen 2.5 7B GGUF model file
MODEL_PATH=/models/qwen2.5-coder-7b-instruct-q4_k_m.gguf

# Context window size (tokens)
N_CTX=8192

# CPU worker threads.  8 is a good starting point for an i7 laptop; tune to
# the number of physical performance cores if the machine becomes sluggish.
N_THREADS=8

# Ollama model name when using its local OpenAI-compatible endpoint.
# terabit-finetuned-v3 measured best on the personalisation A/B
# (backend/ab_v2_v3.py + backend/rescore_ab.py): it was the only tag that
# used the user's real name AND their stated facts AND wrote the copy in
# the user's own language. v2 ignored the language rule; stock
# qwen2.5:7b barely produced a component at all.
MODEL_NAME=terabit-finetuned-v3

# GPU layers (-1 = all, 0 = CPU only)
N_GPU_LAYERS=-1

# Server config
HOST=0.0.0.0
PORT=8000

# JWT secret for auth tokens (change in production!)
JWT_SECRET=change-me-in-production

# ───────── Context-window budgeting ─────────
# get_num_ctx() reads N_CTX above (default 8192). Prompt sections get fixed
# fractions of the window (see context_budget.SECTION_BUDGETS): retrieval 30%,
# IR plan 10%, registry 8%, instructions 35%, leaving ~17% for the completion.
# If you raise N_CTX (e.g. 16384 for q4_K_M on 8GB VRAM), budgets scale
# automatically — no code changes needed.
#
# SPEED TRADEOFF (measured on an RTX 3050 6GB): a 7B Q4_K_M model plus a
# 16384-token KV cache does not fit in 6 GB, so Ollama spills part of the
# model to the CPU (`ollama ps` shows e.g. "21%/79% CPU/GPU") and generation
# slows down several-fold. Setting N_CTX=8192 keeps the whole model resident
# on the GPU and is the single biggest speed win on a 6 GB card; the smaller
# window also shrinks the prompt budgets proportionally, so pair it with
# shorter project files or expect less retrieved context per request.

# LLM server config (llama-server or Ollama)
# LLAMA_SERVER_HOST=localhost
# LLAMA_SERVER_PORT=11434

# -------------- Cloud providers (optional, for big-model quality) --------------
# Terabit is local-first, but any OpenAI-compatible endpoint works for
# generations where a hosted model beats a local 7B. With ONLY an
# OpenRouter key set, the OpenAI provider auto-points at OpenRouter, so
# models too big for this laptop (e.g. Qwen3-Coder 30B = 19 GB in Q4) are
# still usable:
#   OPENROUTER_API_KEY=sk-or-...
#   OPENAI_MODEL=qwen/qwen3-coder
# ...then per request (or the Builder UI): provider="openai".
# Explicit OPENAI_BASE_URL always wins; OPENAI_API_KEY alone targets
# api.openai.com as usual.
# OPENROUTER_API_KEY=
# OPENAI_MODEL=qwen/qwen3-coder

# ───────── In-house fine-tuning (POST /api/finetune/*) ─────────
# The retrain pipeline trains -> exports GGUF -> evals -> gates -> promotes.
# Everything below is optional; the defaults were measured on this laptop.
#
# Where LoRA adapters and GGUF artifacts are written. The export transiently
# needs ~15 GB (f16 merge) plus ~5 GB for the quantized output, so point this
# at your roomiest drive.
# RETRAIN_WORK_DIR=D:/terabit-retrain
#
# llama.cpp toolchain used for the export chain (adapter -> merged fp16 ->
# f16 GGUF -> q4_K_M). Only needed if it isn't at the default path.
# LLAMA_CPP_DIR=D:/terabit-retrain/llama.cpp
# LLAMA_BIN_DIR=D:/terabit-retrain/llama-bin
#
# fp16 HF snapshot the LoRA is merged into (autodiscovered from the HF cache
# when unset). Must be full precision, not the 4-bit base used for training.
# HF_BASE_DIR=C:/Users/me/.cache/huggingface/hub/models--Qwen--Qwen2.5-7B-Instruct/snapshots/<hash>
#
# GGUF quantization the candidate is exported and served with.
# GGUF_QUANT=Q4_K_M
#
# Time-estimate calibration for the fine-tune dashboard (seconds per training
# step; minutes for merge+convert+quantize). Raise them on slower hardware so
# the UI's estimate stays honest.
# TERABIT_SEC_PER_STEP=75
# TERABIT_EXPORT_MINUTES=35
