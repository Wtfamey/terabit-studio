      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Hartley & Rowe — Trusted Legal Counsel</title>\n    <meta name=\"description\" content=\"Hartley & Rowe is a client-first law firm offering clear advice, transparent fees, and proven results.\" />\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n    <style>body { font-family: 'Inter', sans-serif; }</style>\n  </head>\n  <body class=\"bg-white text-slate-900 antialiased min-h-screen\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.jsx\"></script>\n  </body>\n</html>"
