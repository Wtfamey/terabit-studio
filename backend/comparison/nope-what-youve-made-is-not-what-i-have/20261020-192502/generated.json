[
  {
    "path": "src/App.jsx",
    "content": "import React from 'react';\nimport { useState } from 'react';\nimport { ArrowRight, Check, ChevronDown, Clock, Menu, Quote, Scale, ShieldCheck, Sparkles, Star, Users, X, Zap } from 'lucide-react';\n\nconst FEATURES = [\n  { icon: Scale, title: \"Full-service practice\", body: \"From litigation and family law to business counsel \\u2014 one firm, every legal need covered.\" },\n  { icon: ShieldCheck, title: \"Your interests, protected\", body: \"Every engagement starts with a clear letter of engagement and a strategy built around your goals.\" },\n  { icon: Clock, title: \"Responsive by design\", body: \"Calls returned within one business day. You always know where your case stands.\" },\n  { icon: Users, title: \"Clients, not case numbers\", body: \"A dedicated attorney \\u2014 not a rotating cast \\u2014 who knows your matter from first call to final filing.\" },\n];\n\nconst TESTIMONIALS = [\n  {\n    \"quote\": \"We replaced four tools with RautLaw in a week and our throughput doubled. It is the first software the whole team actually opens daily.\",\n    \"name\": \"Maya Chen\",\n    \"role\": \"Head of Operations, Northwind\",\n    \"initials\": \"MC\"\n  },\n  {\n    \"quote\": \"The onboarding was absurdly fast. My team was live before lunch and asking why we waited so long.\",\n    \"name\": \"Daniel Okafor\",\n    \"role\": \"CTO, Brightstack\",\n    \"initials\": \"DO\"\n  },\n  {\n    \"quote\": \"I have bought a lot of software. This is the first demo that ended with the team cheering.\",\n    \"name\": \"Sofia Marino\",\n    \"role\": \"VP Product, Lattice Labs\",\n    \"initials\": \"SM\"\n  }\n];\n\nconst FAQS = [\n  {\n    \"q\": \"What happens in the first consultation?\",\n    \"a\": \"You tell us what happened, we tell you where you stand — candidly. You leave with a clear view of options, timelines and likely costs, whatever you decide.\"\n  },\n  {\n    \"q\": \"How are fees structured?\",\n    \"a\": \"Straightforwardly. Hourly work is billed monthly with a detailed ledger; many standard matters are quoted as one fixed fee before we begin.\"\n  },\n  {\n    \"q\": \"Will I speak with the attorney or a call center?\",\n    \"a\": \"With your attorney. Calls and emails are answered by the lawyer handling your matter, usually the same day.\"\n  },\n  {\n    \"q\": \"How long will my case take?\",\n    \"a\": \"It depends on the matter — at the first meeting you get a realistic timeline, and we flag early if it changes.\"\n  }\n];\n\nconst PLANS = [\n  {\n    \"name\": \"Initial Consultation\",\n    \"price\": 0,\n    \"unit\": \"free\",\n    \"tagline\": \"Meet the team\",\n    \"features\": [\n      \"Case review\",\n      \"Honest assessment\",\n      \"Fee quote upfront\",\n      \"No obligation\"\n    ],\n    \"cta\": \"Book consultation\",\n    \"highlighted\": false\n  },\n  {\n    \"name\": \"Standard Representation\",\n    \"price\": 250,\n    \"unit\": \"/hour\",\n    \"tagline\": \"Full representation\",\n    \"features\": [\n      \"Dedicated attorney\",\n      \"Court appearances\",\n      \"Document drafting\",\n      \"Weekly updates\"\n    ],\n    \"cta\": \"Retain counsel\",\n    \"highlighted\": true\n  },\n  {\n    \"name\": \"Fixed-Fee Matters\",\n    \"price\": 1200,\n    \"unit\": \"from\",\n    \"tagline\": \"Known scope, known price\",\n    \"features\": [\n      \"Wills & estates\",\n      \"Contracts review\",\n      \"Property closings\",\n      \"One flat invoice\"\n    ],\n    \"cta\": \"Get a quote\",\n    \"highlighted\": false\n  }\n];\n\nconst LOGOS = [\"Northwind\", \"Brightstack\", \"Lattice Labs\", \"Acme Corp\", \"Globex\", \"Initech\"];\n\nexport default function App() {\n  const [menuOpen, setMenuOpen] = useState(false);\n  const [openFaq, setOpenFaq] = useState(0);\n  const [email, setEmail] = useState('');\n  const [sent, setSent] = useState(false);\n\n  return (\n    <div className=\"min-h-screen bg-white\">\n      {/* NAV */}\n      <header className=\"fixed top-0 inset-x-0 z-50 bg-gray-100/70 backdrop-blur-xl border-b border-gray-200/70\">\n        <div className=\"max-w-6xl mx-auto px-6 h-16 flex items-center justify-between\">\n          <a href=\"#top\" className=\"flex items-center gap-2\">\n            <span className=\"w-8 h-8 rounded-xl bg-gradient-to-br from-#hex-700 to-#hex-800 flex items-center justify-center\">\n              <Zap className=\"w-4 h-4 text-gray-600\" />\n            </span>\n            <span className=\"font-extrabold text-lg tracking-tight\">{'RautLaw'}</span>\n          </a>\n          <nav className=\"hidden md:flex items-center gap-8 text-sm font-medium text-gray-600\">\n            <a href=\"#features\" className=\"hover:text-gray-900 transition-colors\">Features</a>\n            <a href=\"#pricing\" className=\"hover:text-gray-900 transition-colors\">Pricing</a>\n            <a href=\"#faq\" className=\"hover:text-gray-900 transition-colors\">FAQ</a>\n          </nav>\n          <div className=\"hidden md:flex items-center gap-3\">\n            <a href=\"#pricing\" className=\"text-sm font-semibold text-gray-700 hover:text-gray-900\">Sign in</a>\n            <a href=\"#cta\" className=\"px-4 py-2 rounded-xl bg-#hex-900 text-gray-600 text-sm font-semibold hover:bg-gray-700 transition-colors\">Get started</a>\n          </div>\n          <button className=\"md:hidden p-2\" onClick={() => setMenuOpen(!menuOpen)} aria-label=\"Menu\">\n            {menuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n          </button>\n        </div>\n        {menuOpen && (\n          <div className=\"md:hidden border-t border-gray-200 bg-white px-6 py-4 space-y-3\">\n            {['Features', 'Pricing', 'FAQ'].map(item => (\n              <a key={item} href={`#${item.toLowerCase()}`} onClick={() => setMenuOpen(false)} className=\"block font-medium text-gray-700\">{item}</a>\n            ))}\n            <a href=\"#cta\" className=\"block text-center px-4 py-2.5 rounded-xl bg-#hex-900 text-gray-600 font-semibold transition-all duration-200 active:scale-[0.97]\">Get started</a>\n          </div>\n        )}\n      </header>\n\n      {/* HERO */}\n      <section id=\"top\" className=\"relative pt-36 pb-24 overflow-hidden\">\n        <div className=\"absolute inset-0 -z-10\" style={{ background: 'radial-gradient(60% 50% at 50% 0%, rgba(99,102,241,0.15), transparent 70%)' }} />\n        <div className=\"max-w-6xl mx-auto px-6 text-center\">\n          <div className=\"animate-fade-up inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-#hex-50 border border-#hex-100 text-#hex-700 text-xs font-semibold transition-all duration-300 hover:-translate-y-1 hover:shadow-xl\">\n            <Sparkles className=\"w-3.5 h-3.5\" /> Now accepting new clients\n            <ArrowRight className=\"w-3 h-3\" />\n          </div>\n          <h1 className=\"font-display animate-fade-up mt-6 text-5xl md:text-7xl font-black tracking-tight leading-[1.05]\" style={{'animation-delay': '80ms'}}>\n            Counsel that<br />\n            <span className=\"bg-gradient-to-br from-#hex-700 to-#hex-800 bg-clip-text text-transparent\">protects what matters.</span>\n          </h1>\n          <p className=\"animate-fade-up mt-6 text-lg md:text-xl text-gray-600 max-w-2xl mx-auto\" style={{'animation-delay': '160ms'}}>\n            RautLaw pairs seasoned attorneys with a client-first process — clear advice, honest pricing, and results you can measure.\n          </p>\n          <div className=\"animate-fade-up mt-10 flex flex-col sm:flex-row items-center justify-center gap-4\" style={{'animation-delay': '240ms'}}>\n            <a href=\"#cta\" className=\"w-full sm:w-auto px-8 py-4 rounded-2xl bg-#hex-900 text-white font-bold hover:bg-gray-700 transition-all shadow-xl shadow-gray-900/10\">\n              Book a free consultation\n            </a>\n            <a href=\"#features\" className=\"w-full sm:w-auto px-8 py-4 rounded-2xl border border-gray-300 font-bold text-gray-700 hover:border-gray-400 transition-colors\">\n              Our practice areas\n            </a>\n          </div>\n          <div className=\"mt-14 flex items-center justify-center gap-2 text-sm text-gray-500\">\n            <div className=\"flex -space-x-2\">\n              {['MC', 'DO', 'SM'].map(i => (\n                <div key={i} className=\"w-8 h-8 rounded-full bg-gradient-to-br from-#hex-700 to-#hex-800 border-2 border-gray-200 flex items-center justify-center text-[10px] font-bold text-gray-600\">{i}</div>\n              ))}\n            </div>\n            <span>Trusted by <strong className=\"text-gray-700\">500+</strong> clients and families</span>\n            <span className=\"flex items-center gap-0.5 ml-2\">\n              {[...Array(5)].map((_, i) => <Star key={i} className=\"w-4 h-4 fill-amber-400 text-amber-400\" />)}\n            </span>\n          </div>\n        </div>\n      </section>\n\n      {/* LOGO MARQUEE */}\n      <section className=\"py-10 border-y border-gray-100 overflow-hidden\">\n        <div className=\"flex whitespace-nowrap animate-marquee gap-16 px-8\">\n          {[...LOGOS, ...LOGOS].map((logo, i) => (\n            <span key={i} className=\"text-xl font-bold text-gray-600 tracking-tight\">{logo}</span>\n          ))}\n        </div>\n      </section>\n\n      {/* FEATURES */}\n      <section id=\"features\" className=\"py-28\">\n        <div className=\"max-w-6xl mx-auto px-6\">\n          <div className=\"text-center max-w-2xl mx-auto\">\n            <p className=\"text-sm font-bold uppercase tracking-widest text-#hex-600\">Why RautLaw</p>\n            <h2 className=\"font-display mt-3 text-4xl md:text-5xl font-black tracking-tight\">Serious counsel. Straight answers.</h2>\n            <p className=\"mt-4 text-lg text-gray-600\">Four reasons clients choose RautLaw — and stay for decades.</p>\n          </div>\n          <div className=\"mt-16 grid md:grid-cols-2 gap-6\">\n            {FEATURES.map((f, i) => (\n              <div key={i} className=\"group p-8 rounded-3xl border border-gray-200 hover:border-#hex-200 hover:shadow-xl hover:shadow-#hex-100/60 transition-all\">\n                <div className=\"w-12 h-12 rounded-2xl bg-gradient-to-br from-#hex-700 to-#hex-800 flex items-center justify-center group-hover:scale-110 transition-transform\">\n                  <f.icon className=\"w-6 h-6 text-gray-600\" />\n                </div>\n                <h3 className=\"font-display mt-6 text-xl font-bold\">{f.title}</h3>\n                <p className=\"mt-2 text-gray-600 leading-relaxed\">{f.body}</p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* TESTIMONIALS */}\n      <section className=\"py-28 bg-#hex-900 text-gray-600\">\n        <div className=\"max-w-6xl mx-auto px-6\">\n          <div className=\"text-center max-w-2xl mx-auto\">\n            <p className=\"text-sm font-bold uppercase tracking-widest text-#hex-400\">Loved by teams</p>\n            <h2 className=\"font-display mt-3 text-4xl md:text-5xl font-black tracking-tight\">Don't take our word for it.</h2>\n          </div>\n          <div className=\"mt-16 grid md:grid-cols-3 gap-6\">\n            {TESTIMONIALS.map((t, i) => (\n              <figure key={i} className=\"p-8 rounded-3xl bg-gray-100 border border-gray-200 hover:border-#hex-500/40 transition-colors\">\n                <Quote className=\"w-6 h-6 text-#hex-400\" />\n                <blockquote className=\"mt-4 text-gray-600 leading-relaxed\">{t.quote}</blockquote>\n                <figcaption className=\"mt-6 flex items-center gap-3\">\n                  <div className=\"w-10 h-10 rounded-full bg-gradient-to-br from-#hex-700 to-#hex-800 flex items-center justify-center text-xs font-bold\">{t.initials}</div>\n                  <div>\n                    <div className=\"font-semibold text-sm\">{t.name}</div>\n                    <div className=\"text-xs text-gray-600\">{t.role}</div>\n                  </div>\n                </figcaption>\n              </figure>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* PRICING */}\n      <section id=\"pricing\" className=\"py-28\">\n        <div className=\"max-w-6xl mx-auto px-6\">\n          <div className=\"text-center max-w-2xl mx-auto\">\n            <p className=\"text-sm font-bold uppercase tracking-widest text-#hex-600\">Transparent fees</p>\n            <h2 className=\"font-display mt-3 text-4xl md:text-5xl font-black tracking-tight\">Clear scope. Honest rates.</h2>\n            <p className=\"mt-4 text-lg text-gray-600\">Flat fees where possible. No surprise invoices, ever.</p>\n          </div>\n          <div className=\"mt-16 grid md:grid-cols-3 gap-6 items-start\">\n            {PLANS.map((plan, i) => (\n              <div key={i} className={`relative p-8 rounded-3xl border transition-all ${plan.highlighted\n                ? 'bg-#hex-900 text-gray-600 border-gray-900 shadow-2xl md:-translate-y-3'\n                : 'bg-white border-gray-200 hover:border-gray-300'}`}>\n                {plan.highlighted && (\n                  <div className=\"absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-gradient-to-br from-#hex-700 to-#hex-800 text-white text-[11px] font-bold tracking-wide\">MOST POPULAR</div>\n                )}\n                <h3 className=\"font-display text-lg font-bold\">{plan.name}</h3>\n                <p className={`text-sm mt-1 ${plan.highlighted ? 'text-gray-600' : 'text-gray-500'}`}>{plan.tagline}</p>\n                <div className=\"mt-6 flex items-baseline gap-1\">\n                  {plan.price === null\n                    ? <span className=\"text-4xl font-black\">Custom</span>\n                    : <><span className=\"text-4xl font-black\">${plan.price}</span><span className=\"text-gray-500 font-medium\">{plan.unit}</span></>}\n                </div>\n                <ul className=\"mt-8 space-y-3\">\n                  {plan.features.map((feat, j) => (\n                    <li key={j} className=\"flex items-start gap-3 text-sm\">\n                      <Check className={`w-4 h-4 mt-0.5 flex-shrink-0 ${plan.highlighted ? 'text-#hex-400' : 'text-emerald-500'}`} />\n                      <span className={plan.highlighted ? 'text-gray-600' : 'text-gray-600'}>{feat}</span>\n                    </li>\n                  ))}\n                </ul>\n                <a href=\"#cta\" className={`mt-8 block text-center px-6 py-3.5 rounded-2xl font-bold transition-all ${plan.highlighted\n                  ? 'bg-white text-gray-900 hover:bg-gray-200'\n                  : 'bg-#hex-900 text-gray-600 hover:bg-gray-700'}`}>\n                  {plan.cta}\n                </a>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* FAQ */}\n      <section id=\"faq\" className=\"py-28 bg-gray-50\">\n        <div className=\"max-w-3xl mx-auto px-6\">\n          <div className=\"text-center\">\n            <p className=\"text-sm font-bold uppercase tracking-widest text-#hex-600\">FAQ</p>\n            <h2 className=\"font-display mt-3 text-4xl md:text-5xl font-black tracking-tight\">Questions, answered.</h2>\n          </div>\n          <div className=\"mt-12 space-y-4\">\n            {FAQS.map((faq, i) => (\n              <div key={i} className=\"bg-white rounded-2xl border border-gray-200 overflow-hidden\">\n                <button onClick={() => setOpenFaq(openFaq === i ? -1 : i)} className=\"w-full flex items-center justify-between px-6 py-5 text-left font-semibold\">\n                  {faq.q}\n                  <ChevronDown className={`w-5 h-5 text-gray-600 transition-transform ${openFaq === i ? 'rotate-180' : ''}`} />\n                </button>\n                {openFaq === i && (\n                  <div className=\"px-6 pb-6 text-gray-600 leading-relaxed\">{faq.a}</div>\n                )}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* CTA */}\n      <section id=\"cta\" className=\"py-28\">\n        <div className=\"max-w-4xl mx-auto px-6\">\n          <div className=\"relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-#hex-700 to-#hex-800 px-8 py-16 md:px-16 text-center text-gray-600\">\n            <div className=\"absolute -top-24 -right-24 w-72 h-72 rounded-full bg-gray-100 blur-2xl animate-float-slow\" />\n            <h2 className=\"font-display text-3xl md:text-5xl font-black tracking-tight\">Ready to talk?</h2>\n            <p className=\"mt-4 text-lg text-#hex-100 max-w-xl mx-auto\">Tell us what happened — a RautLaw attorney will respond within one business day. The first consultation is free.</p>\n            {sent ? (\n              <div className=\"mt-10 inline-flex items-center gap-2 px-6 py-4 rounded-2xl bg-gray-100 font-semibold transition-all duration-300 hover:-translate-y-1 hover:shadow-xl\">\n                <Check className=\"w-5 h-5\" /> You're on the list — check your inbox!\n              </div>\n            ) : (\n              <form onSubmit={e => { e.preventDefault(); if (email.includes('@')) setSent(true); }} className=\"mt-10 flex flex-col sm:flex-row gap-3 max-w-md mx-auto\">\n                <input\n                  type=\"email\" required value={email} onChange={e => setEmail(e.target.value)}\n                  placeholder=\"you@company.com\"\n                  className=\"flex-1 px-5 py-4 rounded-2xl bg-gray-100/70 backdrop-blur border border-gray-200 placeholder-#hex-200 text-gray-600 focus:outline-none focus:ring-2 focus:ring-white/60 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl\"\n                />\n                <button type=\"submit\" className=\"px-8 py-4 rounded-2xl bg-white text-#hex-700 font-bold hover:bg-#hex-50 transition-colors\">\n                  Book a free consultation\n                </button>\n              </form>\n            )}\n            <p className=\"mt-6 text-xs text-#hex-200\">Free consultation · No obligation · Confidential</p>\n          </div>\n        </div>\n      </section>\n\n      {/* FOOTER */}\n      <footer className=\"border-t border-gray-200 py-12\">\n        <div className=\"max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-7 h-7 rounded-lg bg-gradient-to-br from-#hex-700 to-#hex-800 flex items-center justify-center\">\n              <Zap className=\"w-3.5 h-3.5 text-gray-600\" />\n            </span>\n            <span className=\"font-bold\">{'RautLaw'}</span>\n          </div>\n          <div className=\"flex items-center gap-8 text-sm text-gray-500\">\n            <a href=\"#features\" className=\"hover:text-gray-900\">Features</a>\n            <a href=\"#pricing\" className=\"hover:text-gray-900\">Pricing</a>\n            <a href=\"#faq\" className=\"hover:text-gray-900\">FAQ</a>\n          </div>\n          <p className=\"text-xs text-gray-600\">© 2026 {'RautLaw'}. All rights reserved.</p>\n        </div>\n      </footer>\n    </div>\n  );\n}"
  }
]