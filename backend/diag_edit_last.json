      "path": "src/App.jsx",
      "content": "import React, { useMemo, useState } from 'react';\nimport {\n  LayoutDashboard, Database, Settings, Search, Plus, X, Filter,\n  TrendingUp, Users, DollarSign, CheckCircle2, Sparkles, Bell, Sparkle\n} from 'lucide-react';\n\nconst NAV = [\n  { id: 'overview', label: 'Dashboard', icon: LayoutDashboard },\n  { id: 'data', label: 'Customers', icon: Database },\n  { id: 'settings', label: 'Billing', icon: Settings },\n];\n\nconst INITIAL_RECORDS = [\n  {\n    id: 1,\n    name: 'Acme Corp',\n    email: 'support@acme.com',\n    value: 18000,\n    status: 'Active',\n    avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&q=80',\n    tier: 'Enterprise',\n    active: true,\n    lastActive: '1d ago'\n  },\n  {\n    id: 2,\n    name: 'EcoTech Solutions',\n    email: 'info@ecotech.com',\n    value: 42000,\n    status: 'Active',\n    avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&q=80',\n    tier: 'Pro',\n    active: true,\n    lastActive: '4h ago'\n  },\n  {\n    id: 3,\n    name: 'Nova Robotics',\n    email: 'admin@novarobots.com',\n    value: 14000,\n    status: 'At Risk',\n    avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&q=80',\n    tier: 'Free',\n    active: false,\n    lastActive: '1w ago'\n  },\n  {\n    id: 4,\n    name: 'Vortex AI',\n    email: 'team@vortexai.io',\n    value: 65000,\n    status: 'Active',\n    avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&q=80',\n    tier: 'Enterprise',\n    active: true,\n    lastActive: '2d ago'\n  },\n  {\n    id: 5,\n    name: 'Synapse Health',\n    email: 'health@synapsehealth.org',\n    value: 12000,\n    status: 'Onboarding',\n    avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&q=80',\n    tier: 'Free',\n    active: true,\n    lastActive: '1d ago'\n  }\n];\n\nexport default function App() {\n  const [view, setView] = useState('overview');\n  const [records, setRecords] = useState(INITIAL_RECORDS);\n  const [search, setSearch] = useState('');\n  const [filter, setFilter] = useState('All');\n  const [toggleDark, setToggleDark] = useState(false);\n  const [isAddOpen, setIsAddOpen] = useState(false);\n  const [newItem, setNewItem] = useState({ name: '', email: '', value: '', tier: 'Free' });\n  const [toast, setToast] = useState(null);\n\n  const toggleTheme = () => setToggleDark(!toggleDark);\n\n  const [churned, setChurned] = useState({\n    total: 3,\n    recent: 2,\n    rate: '-14.2%',\n    delta: -2,\n    recoveryRate: 4.5,\n    active: 15,\n    pending: 10\n  });\n\n  const handleAdd = (e) => {\n    e.preventDefault();\n    if (!newItem.name.trim() || !newItem.email.trim()) return;\n    setRecords([...records, { id: Date.now(), ...newItem, value: 1000, active: true, tier: 'Free' }]);\n    setIsAddOpen(false);\n    setNewItem({ name: '', email: '', value: '', tier: 'Free' });\n    setToast('Customer added');\n  };\n\n  const toggleRecord = (id) => {\n    setRecords(records.map(r => r.id === id ? { ...r, active: !r.active } : r));\n  };\n\n  const handleTierChange = (id, tier) => {\n    setRecords(records.map(r => r.id === id ? { ...r, tier } : r));\n  };\n\n  const activeCount = records.filter(r => r.active).length;\n  const inactiveCount = records.filter(r => !r.active).length;\n  const valueTotal = records.reduce((acc, r) => acc + (r.value || 0), 0);\n  const avgValue = valueTotal / records.length;\n\n  const filtered = useMemo(() => records.filter(r =>\n    (filter === 'All' || r.status === filter) &&\n    r.name.toLowerCase().includes(search.toLowerCase())\n  ), [records, search, filter]);\n\n  const recentChurn = filtered.filter(r => r.status === 'Churned');\n\n  return (\n    <div className={`min-h-screen bg-slate-950 text-slate-100 flex selection:bg-violet-500/30 ${toggleDark ? 'bg-slate-950/80' : ''}`}>\n      <div className=\"w-full max-w-3xl mx-auto p-4 sm:p-6 lg:p-8\">\n        {/* Dark Mode Toggle */}\n        <div className=\"flex items-center justify-between mb-6\">\n          <h1 className=\"text-2xl font-bold text-white flex items-center gap-2\">\n            <Sparkles className=\"w-6 h-6 text-indigo-400\" /> {view}\n          </h1>\n          <div className=\"flex items-center gap-3\">\n            <button onClick={toggleTheme}\n              className=\"p-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-400 transition-colors\">\n              <Sun className=\"w-5 h-5\" />\n            </button>\n            <button onClick={() => setToggleDark(!toggleDark)}\n              className=\"p-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-400 transition-colors\">\n              <Moon className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Top Header with KPIs */}\n        <div className=\"bg-white/5 border border-white/10 rounded-2xl p-4 sm:p-6 flex justify-between items-start gap-4 mb-6\">\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center gap-2\">\n              <Users className=\"w-6 h-6 text-emerald-400\" />\n              <div>\n                <h3 className=\"text-base font-bold text-slate-200\">Active Customers</h3>\n                <p className=\"text-sm text-slate-400\">{activeCount}</p>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <Sparkles className=\"w-6 h-6 text-rose-400\" />\n              <div>\n                <h3 className=\"text-base font-bold text-slate-200\">Churn Rate</h3>\n                <p className=\"text-sm text-slate-400\">{churned.rate}</p>\n              </div>\n            </div>\n          </div>\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center gap-2\">\n              <DollarSign className=\"w-6 h-6 text-amber-400\" />\n              <div>\n                <h3 className=\"text-base font-bold text-slate-200\">Avg Revenue</h3>\n                <p className=\"text-sm text-slate-400\">${avgValue.toFixed(2)}</p>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <Bell className=\"w-6 h-6 text-indigo-400\" />\n              <div>\n                <h3 className=\"text-base font-bold text-slate-200\">Pending Invoicing</h3>\n                <p className=\"text-sm text-slate-400\">{inactiveCount}</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Search Bar & Filter */}\n        <div className=\"mb-6\">\n          <div className=\"flex items-center justify-between mb-4\">\n            <div className=\"flex items-center gap-2\">\n              <Search className=\"w-5 h-5 text-slate-400\" />\n              <input\n                value={search}\n                onChange={(e) => setSearch(e.target.value)}\n                placeholder=\"Search customers...\"\n                className=\"w-full bg-white/5 border border-white/10 rounded-xl py-2 pl-8 pr-4 text-sm focus:outline-none focus:ring-1 focus:ring-violet-500\"\n              />\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <Filter className=\"w-5 h-5 text-slate-400\" />\n              <select\n                value={filter}\n                onChange={(e) => setFilter(e.target.value)}\n                className=\"w-24 bg-white/5 border border-white/10 rounded-xl py-2 pl-4 pr-8 text-sm text-slate-400 focus:outline-none focus:ring-1 focus:ring-violet-500\"\n              >\n                <option value=\"All\">All</option>\n                <option value=\"Active\">Active</option>\n                <option value=\"Churned\">Churned</option>\n              </select>\n              <button onClick={() => setIsAddOpen(true)}\n                className=\"flex items-center gap-1 px-4 py-2 bg-indigo-600/10 border border-indigo-500/20 text-indigo-300 hover:bg-indigo-500/10 hover:text-indigo-200 rounded-xl transition-colors\"\n              >\n                <Plus className=\"w-4 h-4\" /> Add\n              </button>\n            </div>\n          </div>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4\">\n            {filtered.map((r) => (\n              <div\n                key={r.id}\n                className=\"group relative overflow-hidden rounded-2xl bg-white/5 border border-white/10 p-6 hover:border-white/20 transition-all duration-300 hover:shadow-2xl hover:scale-[1.02]\"\n              >\n                {/* Top Gradient Decorative Bar */}\n                <div className=\"absolute -top-2 left-1/2 -translate-x-1/2 w-3/4 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 h-2 rounded\" />\n\n                {/* Avatar & Info */}\n                <div className=\"flex items-center justify-between mb-6\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"w-12 h-12 rounded-xl bg-slate-900/80 border border-slate-900/50 flex items-center justify-center overflow-hidden shadow-lg shadow-slate-900/40\">\n                      <img\n                        src={r.avatar}\n                        alt={r.name}\n                        className=\"w-full h-full object-cover\"\n                      />\n                    </div>\n                    <div>\n                      <h4 className=\"text-sm font-semibold text-slate-100\">{r.name}</h4>\n                      <p className=\"text-xs text-slate-400\">{r.tier}</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    {r.active ? (\n                      <CheckCircle2 className=\"w-5 h-5 text-emerald-400\" />\n                    ) : (\n                      <X className=\"w-5 h-5 text-rose-400\" />\n                    )}\n                    <span className=\"text-xs text-slate-500\">{r.lastActive}</span>\n                  </div>\n                </div>\n\n                {/* Status & Value */}\n                <div className=\"flex items-center justify-between mb-4\">\n                  <div className=\"flex items-center gap-2\">\n                    <DollarSign className=\"w-4 h-4 text-slate-400\" />\n                    <span className=\"text-sm font-semibold text-slate-100\">${r.value}</span>\n                  </div>\n                  <span className={`text-sm text-slate-400 ${STATUS_STYLES[r.status]}`}>\n                    {r.status}\n                  </span>\n                </div>\n\n                {/* Tier Control */}\n                <select\n                  value={r.tier}\n                  onChange={(e) => handleTierChange(r.id, e.target.value)}\n                  className=\"w-full bg-white/5 border border-white/10 rounded-xl py-2 pl-4 pr-8 text-sm text-slate-400 focus:outline-none focus:ring-1 focus:ring-violet-500\"\n                >\n                  <option value=\"Free\">Free</option>\n                  <option value=\"Pro\">Pro</option>\n                  <option value=\"Enterprise\">Enterprise</option>\n                </select>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Add New Customer Modal */}\n        {isAddOpen && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md transition-all duration-300\">\n            <div className=\"relative w-full max-w-md overflow-hidden rounded-2xl bg-slate-900/90 border border-white/10 backdrop-blur-xl shadow-2xl transition-all duration-300\">\n              <div className=\"absolute top-0 right-0 -inset-2.5 bg-indigo-600/10 rounded-bl-2xl\" />\n              <div className=\"absolute bottom-0 left-0 -inset-2.5 bg-indigo-600/10 rounded-tl-2xl\" />\n\n              {/* Header */}\n              <div className=\"flex items-center justify-between p-6 border-b border-white/10\">\n                <h2 className=\"text-lg font-bold text-slate-100 flex items-center gap-2\">\n                  <Plus className=\"w-5 h-5 text-white\" /> New Customer\n                </h2>\n                <button onClick={() => setIsAddOpen(false)}\n                  className=\"p-2 rounded-lg text-slate-400 hover:text-slate-200 transition-colors\"\n                >\n                  <X className=\"w-5 h-5\" />\n                </button>\n              </div>\n\n              {/* Form */}\n              <form onSubmit={handleAdd}>\n                <div className=\"p-6\">\n                  <div className=\"mb-4\">\n                    <label htmlFor=\"name\" className=\"block text-sm font-medium text-slate-400\">Name</label>\n                    <input\n                      id=\"name\"\n                      value={newItem.name}\n                      onChange={(e) => setNewItem({ ...newItem, name: e.target.value })}\n                      className=\"w-full bg-white/5 border border-white/10 rounded-xl py-2 pl-4 pr-10 text-sm focus:outline-none focus:ring-1 focus:ring-violet-500\"\n                      placeholder=\"Enter customer name\"\n                      required\n                    />\n                  </div>\n                  <div className=\"mb-4\">\n                    <label htmlFor=\"email\" className=\"block text-sm font-medium text-slate-400\">Email</label>\n                    <input\n                      id=\"email\"\n                      value={newItem.email}\n                      onChange={(e) => setNewItem({ ...newItem, email: e.target.value })}\n                      className=\"w-full bg-white/5 border border-white/10 rounded-xl py-2 pl-4 pr-10 text-sm focus:outline-none focus:ring-1 focus:ring-violet-500\"\n                      placeholder=\"Enter customer email\"\n                      required\n                    />\n                  </div>\n                  <div className=\"mb-4\">\n                    <label htmlFor=\"value\" className=\"block text-sm font-medium text-slate-400\">Initial Value</label>\n                    <div className=\"flex justify-between items-center w-full\">\n                      <input\n                        type=\"number\"\n                        id=\"value\"\n                        value={newItem.value}\n                        onChange={(e) => setNewItem({ ...newItem, value: e.target.value })}\n                        className=\"w-24 bg-white/5 border border-white/10 rounded-xl py-2 pl-4 pr-6 text-sm focus:outline-none focus:ring-1 focus:ring-violet-500\"\n                        placeholder=\"0\"\n                        min=\"0\"\n                      />\n                      <span className=\"text-sm text-slate-400\">$</span>\n                    </div>\n                  </div>\n                  <div className=\"mb-4\">\n                    <label htmlFor=\"tier\" className=\"block text-sm font-medium text-slate-400\">Tier</label>\n                    <select\n                      id=\"tier\"\n                      value={newItem.tier}\n                      onChange={(e) => setNewItem({ ...newItem, tier: e.target.value })}\n                      className=\"w-full bg-white/5 border border-white/10 rounded-xl py-2 pl-4 pr-8 text-sm focus:outline-none focus:ring-1 focus:ring-violet-500\"\n                    >\n                      <option value=\"Free\">Free</option>\n                      <option value=\"Pro\">Pro</option>\n                      <option value=\"Enterprise\">Enterprise</option>\n                    </select>\n                  </div>\n                </div>\n\n                {/* Footer */}\n                <div className=\"p-4 bg-white/5 border-t border-white/10 flex justify-end gap-4\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setIsAddOpen(false)}\n                    className=\"px-4 py-2 rounded-xl text-sm bg-slate-900 hover:bg-slate-800 text-slate-400 border border-slate-900/50 hover:border-slate-800\"\n                  >\n                    Cancel\n                  </button>\n                  <button type=\"submit\" className=\"px-4 py-2 rounded-xl text-sm bg-indigo-600 hover:bg-indigo-500 text-slate-100 border border-indigo-600/50 hover:border-indigo-500\">\n                    Add Customer\n                  </button>\n                </div>\n              </form>\n            </div>\n          </div>\n        )}\n\n        {/* Churned Customers List */}\n        {recentChurn.length > 0 && (\n          <div className=\"mt-8 bg-white/5 border border-white/10 rounded-2xl p-6 shadow-lg shadow-slate-900/40\">\n            <h3 className=\"text-lg font-bold text-slate-100 mb-4\">Recent Churned</h3>\n            <ul className=\"space-y-4\">\n              {recentChurn.map((r) => (\n                <li key={r.id} className=\"flex items-center justify-between p-3 rounded-lg bg-white/10 border border-white/20 hover:bg-white/15 transition-all\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"w-12 h-12 rounded-xl bg-slate-900/80 border border-slate-900/50 flex items-center justify-center overflow-hidden shadow-lg shadow-slate-900/40\">\n                      <img\n                        src={r.avatar}\n                        alt={r.name}\n                        className=\"w-full h-full object-cover\"\n                      />\n                    </div>\n                    <div>\n                      <h4 className=\"text-sm font-semibold text-slate-100\">{r.name}</h4>\n                      <p className=\"text-xs text-slate-400\">{r.tier}</p>\n                    </div>\n                  </div>\n                  <span className=\"text-xs text-rose-400\">{r.lastActive}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n        )}\n\n        {/* Global Churn Stats */}\n        {churned.total > 0 && (\n          <div className=\"mt-8 bg-white/5 border border-white/10 rounded-2xl p-6 shadow-lg shadow-slate-900/40\">\n            <h3 className=\"text-lg font-bold text-slate-100 mb-4\">Global Churn Analytics</h3>\n            <div className=\"flex items-start justify-between mb-6\">\n              <div className=\"flex items-center gap-2\">\n                <AlertTriangle className=\"w-6 h-6 text-amber-400\" />\n                <div>\n                  <h4 className=\"text-sm font-semibold text-slate-100\">Total Churned</h4>\n                  <p className=\"text-base font-bold text-rose-400\">{churned.total}</p>\n                </div>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <AlertCircle className=\"w-6 h-6 text-rose-400\" />\n                <div>\n                  <h4 className=\"text-sm font-semibold text-slate-100\">Active Subscriptions</h4>\n                  <p className=\"text-base font-bold text-emerald-400\">{activeCount}</p>\n                </div>\n              </div>\n            </div>\n            <div className=\"w-full bg-white/10 rounded-xl border border-white/20 p-4\">\n              <div className=\"flex items-center justify-between mb-4\">\n                <h4 className=\"text-sm font-semibold text-slate-100\">Churn Rate Trend</h4>\n                <span className=\"text-xs text-slate-400\">{churned.rate}</span>\n              </div>\n              <div className=\"w-full bg-slate-900/20 rounded-full h-2.5 overflow-hidden\">\n                <div\n                  style={{ width: `${churned.delta}%` }}\n                  className=\"h-full bg-rose-500/30\"\n                />\n              </div>\n            </div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <CheckCircle2 className=\"w-5 h-5 text-emerald-400\" />\n                <span>{churned.recoveryRate}% Recovery Rate</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <AlertCircle className=\"w-5 h-5 text-rose-400\" />\n                <span>{churned.pending} Pending Renewals</span>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}"
    },
